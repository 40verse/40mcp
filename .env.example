# 40mcp Configuration
# This file documents every environment variable read by the 40mcp runtime.
# Copy to .env and fill in your values. Never commit .env to version control.

# ============================================================================
# VAULT & SECURITY
# ============================================================================

# Key Encryption Key (KEK) passphrase for vault encryption/decryption
# Stored securely in vault-daemon only; never in plaintext logs
# Required for: vault init, vault recover, daemon operations
VAULT_PASSPHRASE=<set-a-strong-passphrase>

# Vault daemon secret (obtained via daemon socket auth handshake)
# Never printed to stderr; obtained only through daemon socket
# Used for daemon authentication and secret unsealing
# VAULT_DAEMON_SECRET=<obtained-from-daemon-handshake>

# ============================================================================
# API AUTHENTICATION & TRANSPORT
# ============================================================================

# Generic API key (for --auth-env flag)
# Used when serving APIs that require a single API key header
# API_KEY=your-api-key-here

# Generic bearer token (for --auth-bearer-env flag)
# Used when serving APIs that require bearer token authentication
# BEARER_TOKEN=your-bearer-token-here

# GitHub GraphQL token (example for --auth-bearer-env GH_TOKEN)
# GH_TOKEN=<your-github-token>

# ============================================================================
# RUNTIME ENVIRONMENT
# ============================================================================

# Node.js environment (development, production, test)
# WARNING: Set to "production" in all production deployments.
# Leaving as "development" exposes internal error details in API responses.
# NODE_ENV=development

# Disable color output in terminal UI (set to any non-empty value to disable colors)
# Automatically disabled in non-TTY environments (pipes, redirects, CI/CD)
# NO_COLOR=1

# ============================================================================
# SSE TRANSPORT CONFIGURATION
# ============================================================================

# Maximum number of concurrent SSE connections allowed
# Prevents unbounded memory growth under connection-flood DoS attacks
# Default: 100 connections
# MAX_SSE_CONNECTIONS=100

# ============================================================================
# CONFIG LOADING (advanced)
# ============================================================================

# Path-delimited list of additional directories from which 40mcp will load
# config files. By default only CWD and ~/.40mcp/ are allowed; set this to
# widen the allowlist for ops-managed config trees. Read by src/config.js.
# Use ":" on POSIX shells and ";" on Windows.
# FOURDMCP_CONFIG_DIRS=/etc/40mcp:/srv/shared/mcp-configs

# Hard kill-switch that refuses to load .js (ESM) config files. Set to "1"
# in locked-down environments to force JSON-only configs. Read by src/config.js.
# FOURDMCP_NO_JS_CONFIG=1

# ============================================================================
# DEBUG (advanced)
# ============================================================================

# Emit verbose chain execution traces to stderr (step inputs, outputs, bindings).
# Noisy; for development only. Read by src/compose/chain.js.
# FOURDMCP_CHAIN_DEBUG=1

# ============================================================================
# NOTES
# ============================================================================
#
# - Secrets (VAULT_PASSPHRASE, API keys, tokens) should be sourced at runtime,
#   never committed to version control.
# - Use a .env file locally (gitignored) and environment variables in CI/CD.
# - The vault system ensures secrets never exist in plaintext at rest or in process.env.
#
