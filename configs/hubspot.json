        "pick": [
          "id",
          "properties.subject",
          "properties.hs_ticket_priority",
          "properties.hs_pipeline_stage",
          "properties.createdate",
          "properties.hs_lastmodifieddate"
        ],
        "limit": 25,
        "summary": true,
        "tokenBudget": 4000
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "max_results": {
            "type": "integer",
            "description": "Max tickets to return (1-100)"
          },
          "after_cursor": {
            "type": "string",
            "description": "Pagination cursor from previous response"
          },
          "properties": {
            "type": "string",
            "description": "Comma-separated additional properties to include"
          }
        }
      }
    },
    {
