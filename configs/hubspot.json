        ]
      }
    },
    {
      "name": "get_pipeline",
      "description": "Get details of a specific CRM pipeline including all stages with their IDs and display order.",
      "method": "GET",
      "path": "/crm/v3/pipelines/:object_type/:pipeline_id",
      "response": {
        "pick": [
          "id",
          "label",
          "displayOrder",
          "stages"
        ],
        "tokenBudget": 4000
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "object_type": {
            "type": "string",
            "enum": [
              "deals",
              "tickets"
            ],
            "description": "CRM object type the pipeline belongs to"
          },
          "pipeline_id": {
            "type": "string",
            "description": "Pipeline ID (use 'default' for the default deal pipeline)"
          }
        },
        "required": [
          "object_type",
          "pipeline_id"
        ]
      }
    }
  ]
}
